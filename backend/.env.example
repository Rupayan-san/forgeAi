# Forge AI Docker development environment
# Copy this file to backend/.env and replace every provider secret before use.

# Application
PROJECT_NAME=ForgeAI
DEBUG=true
SECRET_KEY=replace-with-a-long-local-development-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=15

# Infrastructure (Docker Compose service names)
MONGODB_URL=mongodb://mongodb:27017
MONGODB_DB_NAME=forge_ai
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
TELEMETRY_ENABLED=true
SERVICE_NAME=forge-ai
ENVIRONMENT=development

# Application secrets (never commit backend/.env)
OPENAI_API_KEY=replace-with-openai-key
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=forge-ai

# GitHub OAuth
GITHUB_CLIENT_ID=replace-with-github-client-id
GITHUB_CLIENT_SECRET=replace-with-github-client-secret
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback
GITHUB_WEBHOOK_SECRET=replace-with-github-webhook-secret
GITHUB_TOKEN=
GITHUB_PERSONAL_ACCESS_TOKEN=

# Agora
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=

# Optional Discord profile. Leave empty to keep Discord disabled.
DISCORD_BOT_TOKEN=

# Groq
GROQ_API_KEY=

# Frontend
FRONTEND_URL=http://localhost:3000
